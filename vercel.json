{
  "installCommand": "npm install --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://quotation-platform-api.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://quotation-platform-api.onrender.com/health" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
